+}
+
+.contact-info-card .contact-info-label {
+  margin-bottom: 0.2rem;
+}
+
+.contact-info-value {
+  word-break: break-word;
+}
+
+.input-invalid {
+  border-color: rgba(255, 120, 110, 0.65) !important;
+  background: rgba(255, 90, 80, 0.06) !important;
+}
+
+.input-invalid:focus {
+  border-color: rgba(255, 120, 110, 0.9) !important;
+  box-shadow: 0 0 0 3px rgba(255, 90, 80, 0.14) !important;
+}
+
+.form-error {
+  margin: 0.4rem 0 0;
+  font-size: 0.75rem;
+  line-height: 1.4;
+  color: #ff9a90;
+}
+
+/* keep the label above the value inside the contact cards */
+.contact-info-card > span:last-child {
