+
+.contact-info-icon {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  flex: 0 0 36px;
+  border-radius: 11px;
+  color: var(--color-accent-warm);
+  background: rgba(212, 165, 116, 0.13);
