index 851d84a..4695a57 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -1156,3 +1156,229 @@ button:focus-visible {
     scroll-behavior: auto !important;
   }
 }
+
+/* =========================================================
+   Ambient backdrop + refreshed surface styles
+   ========================================================= */
+.page-aurora {
+  position: fixed;
+  inset: 0;
+  z-index: 0;
+  pointer-events: none;
+  overflow: hidden;
+}
+
+.page-aurora::before {
+  content: "";
+  position: absolute;
+  inset: -30%;
+  background:
+    radial-gradient(38% 32% at 20% 16%, rgba(212, 165, 116, 0.17), transparent 70%),
+    radial-gradient(34% 30% at 84% 10%, rgba(122, 96, 255, 0.13), transparent 72%),
+    radial-gradient(42% 38% at 72% 84%, rgba(212, 165, 116, 0.11), transparent 72%),
+    radial-gradient(30% 26% at 10% 80%, rgba(64, 180, 160, 0.10), transparent 70%);
+  filter: blur(30px);
+  animation: auroraDrift 36s ease-in-out infinite alternate;
+}
+
+.page-aurora::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background-image:
+    linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
+  background-size: 64px 64px;
+  -webkit-mask-image: radial-gradient(circle at 50% 28%, #000 0%, transparent 76%);
+  mask-image: radial-gradient(circle at 50% 28%, #000 0%, transparent 76%);
+}
+
+@keyframes auroraDrift {
+  0% { transform: translate3d(-2%, -1%, 0) scale(1); }
+  50% { transform: translate3d(2%, 2%, 0) scale(1.06); }
+  100% { transform: translate3d(-1%, 1%, 0) scale(1.02); }
+}
+
+main,
+footer {
+  position: relative;
+  z-index: 1;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .page-aurora::before { animation: none; }
+}
+
+/* Cards and panels pick up a warmer, glassier surface */
+.card {
+  border-radius: 22px;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.014));
+  border-color: rgba(255, 255, 255, 0.09);
+  box-shadow: 0 26px 70px -34px rgba(0, 0, 0, 0.85);
+}
+
+.premium-panel {
+  border-radius: 20px;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
+  border: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.btn-primary {
+  background: linear-gradient(135deg, #e8cb9f 0%, #d4a574 52%, #b9855a 100%);
+  color: #17120d;
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  box-shadow: 0 16px 40px -20px rgba(212, 165, 116, 0.65);
+}
+
+/* Contact call-to-action box */
+.contact-cta-box {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  width: 100%;
+  padding: 1.15rem 1.3rem;
+  border-radius: 18px;
+  cursor: pointer;
+  text-align: left;
+  color: var(--color-text-primary);
+  background: linear-gradient(140deg, rgba(212, 165, 116, 0.17), rgba(255, 255, 255, 0.03));
+  border: 1px solid rgba(212, 165, 116, 0.32);
+  transition: transform 0.35s var(--transition-smooth), box-shadow 0.35s var(--transition-smooth),
+    border-color 0.35s var(--transition-smooth);
+}
+
+.contact-cta-box:hover,
+.contact-cta-box:focus-visible {
+  transform: translateY(-2px);
+  border-color: rgba(212, 165, 116, 0.55);
+  box-shadow: 0 24px 60px -26px rgba(212, 165, 116, 0.5);
+}
+
+.contact-cta-icon {
+  display: grid;
+  place-items: center;
+  width: 42px;
+  height: 42px;
+  flex: 0 0 42px;
+  border-radius: 12px;
+  color: var(--color-accent-warm);
+  background: rgba(212, 165, 116, 0.14);
+  border: 1px solid rgba(212, 165, 116, 0.28);
+}
+
+.contact-cta-title {
+  display: block;
+  font-size: 1.02rem;
+  font-weight: 650;
+  letter-spacing: -0.01em;
+}
+
+.contact-cta-sub {
+  display: block;
+  margin-top: 2px;
+  font-size: 0.78rem;
+  color: var(--color-text-secondary);
+}
+
+.contact-cta-arrow {
+  margin-left: auto;
+  font-size: 1.15rem;
+  color: var(--color-accent-warm);
+  transition: transform 0.3s var(--transition-smooth);
+}
+
+.contact-cta-box:hover .contact-cta-arrow {
+  transform: translateX(4px);
+}
+
+/* Contact sheet */
+.contact-sheet {
+  position: fixed;
+  inset: 0;
+  z-index: 9998;
+  display: grid;
+  place-items: center;
+  padding: 1.2rem;
+  background: rgba(6, 6, 6, 0.74);
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+}
+
+.contact-sheet-panel {
+  width: min(430px, 100%);
+  padding: 1.35rem;
+  border-radius: 22px;
+  background: linear-gradient(160deg, #16161a, #0a0a0b);
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  box-shadow: 0 40px 100px -34px #000;
+}
+
+.contact-sheet-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 1rem;
+}
+
+.contact-sheet-close {
+  background: none;
+  border: 0;
+  color: var(--color-text-secondary);
+  font-size: 1.4rem;
+  line-height: 1;
+  cursor: pointer;
+  padding: 0 0.2rem;
+}
+
+.contact-sheet-close:hover {
+  color: var(--color-text-primary);
+}
+
+.contact-option {
+  display: flex;
+  align-items: center;
+  gap: 0.85rem;
+  padding: 0.9rem 1rem;
+  margin-bottom: 0.6rem;
+  border-radius: 14px;
+  color: inherit;
+  text-decoration: none;
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  background: rgba(255, 255, 255, 0.035);
+  transition: all 0.25s var(--transition-smooth);
+}
+
+.contact-option:last-child {
+  margin-bottom: 0;
+}
+
+.contact-option:hover {
+  border-color: rgba(212, 165, 116, 0.45);
+  background: rgba(212, 165, 116, 0.1);
+  transform: translateY(-1px);
+}
+
+.contact-option-icon {
+  display: grid;
+  place-items: center;
+  width: 34px;
+  height: 34px;
+  flex: 0 0 34px;
+  border-radius: 10px;
+  font-size: 0.8rem;
+  color: var(--color-accent-warm);
+  background: rgba(212, 165, 116, 0.12);
+}
+
+.contact-option b {
+  display: block;
+  font-size: 0.92rem;
+  font-weight: 600;
+}
+
+.contact-option small {
+  display: block;
+  font-size: 0.76rem;
+  color: var(--color-text-secondary);
+  word-break: break-word;
+}
