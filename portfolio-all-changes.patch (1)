+  -webkit-mask-image: radial-gradient(circle at 50% 32%, #000 0%, transparent 82%);
+  mask-image: radial-gradient(circle at 50% 32%, #000 0%, transparent 82%);
+}
+
+.aurora-dots {
+  position: absolute;
