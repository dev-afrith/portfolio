From 823a0add6479563d15b4ea2d073cebfb7c8c60b8 Mon Sep 17 00:00:00 2001
From: Muhammad Afrith D <204439824+dev-afrith@users.noreply.github.com>
Date: Sun, 22 Nov 2026 09:05:22 +0000
Subject: [PATCH 1/4] fix(nav): make the mobile menu readable and hide the page
 behind it
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The nav faded itself to 40% opacity at the top of the page, which washed
out the whole dropdown — the menu opened but its links were nearly
invisible against the hero.

- drop the scroll-driven opacity transform on <nav>; the bar keeps its
  frosted background and still switches to a solid tint once scrolled
- mobile menu: opaque #0b0b0b panel, shadow, and high-contrast links with
  index numbers and arrows instead of muted grey text
- add a full-viewport scrim behind the menu (click to close) and lock
  body scroll while it is open
- tapping a menu item closes the panel, releases the scroll lock, and
  lets the existing Lenis anchor handler scroll to the section; a
  reduced-motion fallback keeps the target clear of the navbar via
  scroll-margin-top
---
 src/app/globals.css       | 68 ++++++++++++++++++++++++++++++++-------
 src/components/Navbar.tsx | 58 +++++++++++++++++++++++++++------
 2 files changed, 105 insertions(+), 21 deletions(-)

diff --git a/src/app/globals.css b/src/app/globals.css
index 07d3a64..aff2f6f 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -428,6 +428,14 @@ body::after {
   background: var(--color-bg-primary);
 }
 
+/* Anchor targets clear the fixed navbar when Lenis is not driving the scroll
+   (SmoothScroll is skipped for users who prefer reduced motion). */
+@media (prefers-reduced-motion: reduce) {
+  section[id] {
+    scroll-margin-top: 84px;
+  }
+}
+
 /* ===== Full Width Navbar ===== */
 .navbar {
   position: fixed;
@@ -543,37 +551,73 @@ body::after {
   transform: rotate(-45deg);
 }
 
+.nav-scrim {
+  position: fixed;
+  inset: 0;
+  z-index: 999;
+  background: rgba(6, 6, 6, 0.78);
+  backdrop-filter: blur(10px) saturate(120%);
+  -webkit-backdrop-filter: blur(10px) saturate(120%);
+}
+
 .mobile-menu {
   position: absolute;
   top: 100%;
   left: 0;
   right: 0;
-  background: rgba(10, 10, 10, 0.9);
-  backdrop-filter: blur(26px) saturate(135%);
-  border-bottom: 1px solid var(--color-border-subtle);
-  padding: 1rem 1.25rem 1.35rem;
+  background: #0b0b0b;
+  border-bottom: 1px solid var(--color-border-medium);
+  box-shadow: 0 28px 60px rgba(0, 0, 0, 0.55);
+  padding: 0.85rem 1.1rem 1.15rem;
   display: flex;
   flex-direction: column;
-  gap: 0.35rem;
-  overflow: hidden;
+  gap: 0.45rem;
+  max-height: calc(100dvh - 84px);
+  overflow-y: auto;
 }
 
 .mobile-nav-link {
-  color: var(--color-text-secondary);
+  display: flex;
+  align-items: center;
+  gap: 0.7rem;
+  color: var(--color-text-primary);
   text-decoration: none;
-  font-size: 0.95rem;
+  font-size: 1rem;
   font-weight: 600;
-  padding: 0.85rem 1rem;
+  letter-spacing: -0.01em;
+  padding: 0.95rem 1rem;
   border-radius: 14px;
-  border: 1px solid rgba(255, 255, 255, 0.04);
-  background: rgba(255, 255, 255, 0.025);
+  border: 1px solid rgba(255, 255, 255, 0.09);
+  background: rgba(255, 255, 255, 0.05);
   transition: all 0.2s ease;
 }
 
+.mobile-nav-index {
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 0.68rem;
+  letter-spacing: 0.12em;
+  color: var(--color-text-tertiary);
+}
+
+.mobile-nav-label {
+  flex: 1;
+}
+
+.mobile-nav-arrow {
+  font-size: 0.9rem;
+  color: var(--color-text-tertiary);
+}
+
 .mobile-nav-link:hover,
 .mobile-nav-link.active {
   color: var(--color-accent-warm);
-  background: rgba(212, 165, 116, 0.08);
+  background: rgba(212, 165, 116, 0.14);
+  border-color: rgba(212, 165, 116, 0.38);
+}
+
+.mobile-nav-link:hover .mobile-nav-arrow,
+.mobile-nav-link.active .mobile-nav-arrow {
+  color: var(--color-accent-warm);
 }
 
 /* ===== Hero Canvas ===== */
